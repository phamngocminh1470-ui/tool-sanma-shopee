# Thông tin dự án
PROJECT_NAME="TUẤN ANH STUDIO — SHOPEE AUTO VOUCHER HUNTER ULTRA"
VERSION="1.0.0-ULTRA"
COPYRIGHT="Bản quyền TUẤN ANH STUDIO"
SLOGAN="AUTOMATE THE SEARCH. ORGANIZE THE VALUE."

# Cơ sở dữ liệu SQLite WAL
# DATABASE_URL="sqlite:///backend/data/voucher_hunter.db"

# Autonomous Collection Scheduler
AUTO_SCAN_ENABLED=true
DEFAULT_SCAN_INTERVAL_MINUTES=15
MAX_CONCURRENT_WORKERS=4
REQUEST_TIMEOUT_SECONDS=25
RATE_LIMIT_DELAY_SECONDS=1.0

# Thông báo Telegram (Tùy chọn)
# TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"
# TELEGRAM_CHAT_ID="987654321"
MIN_SCORE_FOR_ALERT=70

# Trọng số thuật toán xếp hạng chất lượng (Tổng = 1.0)
WEIGHT_VALUE=0.35
WEIGHT_RELIABILITY=0.20
WEIGHT_APPLICABILITY=0.20
WEIGHT_URGENCY=0.15
WEIGHT_CONFIDENCE=0.10
